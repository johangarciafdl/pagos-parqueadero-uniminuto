# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Parqueadero UNIMINUTO - Pagos UWallet"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Wompi (sandbox) - https://comercios.wompi.co/
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_changethis
WOMPI_PRIVATE_KEY=prv_test_changethis
WOMPI_INTEGRITY_SECRET=changethis
WOMPI_EVENTS_SECRET=changethis

# Push notifications (Web Push) - generar con: uvx py-vapid --gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=soporte@uniminuto.edu.co

# Secreto compartido para que un cron externo llame /internal/check-expiring-plans
CRON_SECRET=changethis
